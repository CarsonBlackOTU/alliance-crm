# Alliance CRM environment file
# NOTE (in-universe): committed to the repo during a rushed go-live. Nobody
# circled back to rotate these or add .env to .gitignore.  // VULN A02 (secrets in repo)
DATABASE_URL=postgres://alliance:alliance_pg_pw@127.0.0.1:5433/alliance_crm

# Weak, guessable JWT signing secret (also hardcoded as fallback in src/auth.js)  // VULN A02
JWT_SECRET=alliance

# Default admin bootstrap password that was never changed  // VULN A05 / A07
DEFAULT_ADMIN_PASSWORD=admin123

# Bind address. For the host-only VirtualBox lab set this to the host-only
# adapter IP (e.g. 192.168.56.10). 0.0.0.0 works inside an isolated VM.
HOST=0.0.0.0
PORT=4000
